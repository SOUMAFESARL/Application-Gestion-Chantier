# Valeurs par défaut de DÉVELOPPEMENT, versionnées : toute machine qui clone
# le dépôt obtient le même comportement que le poste de référence (API
# distante, écrans non encore branchés sur simulation, outils de test).
#
# Ordre de priorité (Next) : variables du processus > .env.local > .env.
#   - un `.env.local` sur une machine reste libre de tout surcharger ;
#   - le build de production (deploy-cpanel.yml) pose ses propres valeurs,
#     dont NEXT_PUBLIC_ENVIRONNEMENT=production, qui masque les outils de test.
#
# Aucun secret ici : uniquement des NEXT_PUBLIC_*, publics dans le bundle.
# Documentation de chaque variable : .env.example.

NEXT_PUBLIC_API_URL=https://api-chantier.soumafe.com/api/v1
NEXT_PUBLIC_API_PORT=8000
NEXT_PUBLIC_DOMAINE_PRINCIPAL=localhost
NEXT_PUBLIC_API_SIMULE=1
NEXT_PUBLIC_API_LATENCE_SIMULEE=0
NEXT_PUBLIC_ENVIRONNEMENT=
