# Frontend CCD Digital — variables d'environnement.
# Copier en `.env.local` (non versionné) et ajuster.

# Adresse de l'API — un seul hôte pour toutes les entreprises.
#
# L'entreprise ne se lit pas dans l'adresse : elle voyage dans le jeton de
# connexion. Aucune entreprise n'a de sous-domaine.
#   http://127.0.0.1:8000                développement (défaut si vide)
#   https://api-chantier.soumafe.com     production (posée par deploy-cpanel.yml)
# 127.0.0.1 plutôt que localhost : Windows essaie d'abord ::1, où le serveur de
# développement de Django n'écoute pas.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Hôte des appels de la plateforme (inscription, facturation, administration).
# Vide : le même que NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_PLATEFORME=

# Parcours d'inscription et d'onboarding : les endpoints de T-021, T-024 et
# T-025 ne sont pas encore écrits (DEV-8 à DEV-12). À `1`, les écrans tournent
# sur `lib/api/simulation` et affichent le bandeau « données simulées » que le
# guide frontend §8 impose. À `0`, ils appellent le vrai serveur.
NEXT_PUBLIC_API_SIMULE=1

# Latence artificielle des réponses simulées (300 à 700 ms). Éteinte par
# défaut : elle ne sert qu'à travailler un état de chargement. `1` la rallume.
NEXT_PUBLIC_API_LATENCE_SIMULEE=0

# `production` masque les outils de test (dev/garde.ts), dont « Voir en tant que… ».
# Seul le build de déploiement (deploy-cpanel.yml) le pose : laissé vide, sur
# un poste ou un serveur de recette, les outils restent visibles.
NEXT_PUBLIC_ENVIRONNEMENT=
