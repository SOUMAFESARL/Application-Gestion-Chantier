# Frontend CCD Digital — variables d'environnement.
# Copier en `.env.local` (non versionné) et ajuster.

# Adresse de l'API — SURCHARGE, facultative.
#
# Par défaut, le client la déduit du sous-domaine du navigateur : la page
# servie sur `sotra.ccd-digital.ci` appelle `sotra.ccd-digital.ci`. Le
# sous-domaine EST l'identité du tenant, et un même build sert donc toutes
# les entreprises clientes.
#
# En développement, le frontend est servi sur `localhost:3000`, sans
# sous-domaine de client : il ne peut rien déduire, et on lui désigne un
# tenant à la main.
#   http://demo.localhost:8000      entreprise de démonstration
#   http://localhost:8000           schéma public (inscription, facturation)
# Adresse de l'API. **À laisser vide** : le client la déduit du sous-domaine du
# navigateur, ce qui fait qu'un même build sert toutes les entreprises. La
# renseigner épingle le frontend sur un seul tenant — un client fraîchement
# inscrit se verrait alors refuser sa connexion, ses identifiants étant demandés
# à l'espace de quelqu'un d'autre.
NEXT_PUBLIC_API_URL=

# Le port de l'API, quand il diffère de celui du frontend — c'est le cas en
# développement (3000 / 8000), jamais en production, où les deux partagent
# l'hôte et le port. Laisser vide en production.
NEXT_PUBLIC_API_PORT=8000

# Le domaine de la plateforme, pendant du DOMAINE_PRINCIPAL de Django. Il porte
# l'inscription et la facturation, qui ne vivent sur aucun sous-domaine client.
NEXT_PUBLIC_DOMAINE_PRINCIPAL=localhost

# Parcours d'inscription et d'onboarding : les endpoints de T-021, T-024 et
# T-025 ne sont pas encore écrits (DEV-8 à DEV-12). À `1`, les écrans tournent
# sur `lib/api/simulation` et affichent le bandeau « données simulées » que le
# guide frontend §8 impose. À `0`, ils appellent le vrai serveur.
NEXT_PUBLIC_API_SIMULE=1
